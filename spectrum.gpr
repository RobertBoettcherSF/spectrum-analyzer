project Spectrum is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/native";
   for Exec_Dir use ".";
   for Main use ("smoke.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnatwe", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Spectrum;
